CELERY:
  BROKER_URL: __CELERY_BROKER_URL__
MONGO:
  URI: __MONGO_URI__
  DB: arl
QUERY_PLUGIN:
  alienvault:
    rate_interval: 2
    retry_count: 2
    retry_sleep: 5
    rate_limit_cooldown: 300
    enable: true
  certspotter:
    after_id: 1
    max_page: 3
    enable: true
  crtsh:
    rate_interval: 2
    retry_count: 2
    retry_sleep: 5
    include_expired: true
    upstream_circuit_seconds: 120
    enable: true
  fofa:
    enable: false
  fofa_cert:
    enable: false
  hunter_cert:
    inherit: hunter_qax
    enable: false
  hunter_qax:
    api_key: ''
    page_size: 100
    max_page: 60
    is_web: 3
    rate_interval: 2.5
    retry_count: 3
    retry_sleep: 15
    upstream_retry_count: 1
    upstream_retry_sleep: 3
    network_retry_count: 1
    enable: false
  passivetotal:
    auth_email: ''
    auth_key: ''
    enable: false
  shodan:
    api_key: ''
    enable: false
  censys:
    auth_email: ''
    auth_key: ''
    enable: false
  quake_360:
    quake_token: ''
    max_size: 6000
    page_size: 100
    ignore_cache: true
    connect_timeout: 8.1
    read_timeout: 20.1
    rate_interval: 1
    retry_count: 3
    retry_sleep: 15
    upstream_retry_count: 1
    upstream_retry_sleep: 3
    upstream_circuit_seconds: 120
    auth_retry_count: 1
    network_retry_count: 1
    enable: false
  quake_cert:
    inherit: quake_360
    enable: false
  rapiddns:
    enable: true
  securitytrails:
    api_key: ''
    enable: false
  virustotal:
    api_key: ''
    enable: false
  zoomeye:
    api_key: ''
    max_page: 20
    enable: false
  chaos:
    api_key: ''
    enable: false
  subfinder:
    enable: true
    bin: /usr/local/bin/subfinder
    timeout: 60
    sources:
    - anubis
    - commoncrawl
    - digitorus
    - dnsdumpster
    - hackertarget
    - robtex
    - sitedossier
    - waybackarchive
  wayback:
    enable: true
    timeout: 30
    max_results: 20000
